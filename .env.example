# ─────────────────────────────────────────────────────────
# Base de datos (SQLite local)
# ─────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ID del usuario por defecto (single-user mode)
# Para multi-usuario, reemplazar por session.user.id de NextAuth/Clerk
SEED_USER_ID="user_default"

# ─────────────────────────────────────────────────────────
# IA — modo mock (no requiere API keys, ideal para desarrollo)
# ─────────────────────────────────────────────────────────
# Con AI_MOCK=true:
#   - El Probador Virtual devuelve la foto del usuario sin modificar
#   - Las Sugerencias IA devuelven combinaciones de ejemplo estáticas
AI_MOCK="true"

# ─────────────────────────────────────────────────────────
# IA — producción (cambiar AI_MOCK a "false" para activar)
# ─────────────────────────────────────────────────────────

# Replicate — Virtual Try-On con IDM-VTON
# Consigue tu token en: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# Anthropic Claude — Sugerencias de combinaciones de outfits
# Consigue tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────
# Opcional — URL base para try-on con imágenes locales
# Solo necesario si el servidor de Replicate no puede acceder
# a tu localhost (ej. en desarrollo con ngrok)
# ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_BASE_URL="https://tu-ngrok-url.ngrok.io"
