# ─────────────────────────────────────────────────────────
# Base de datos — Supabase (Postgres)
# ─────────────────────────────────────────────────────────
# DATABASE_URL: connection string en runtime. Usa el "Transaction pooler" (puerto 6543).
DATABASE_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexión directa (puerto 5432). La usa Prisma SOLO para migraciones.
# Usa el "Session pooler". En Vercel no es imprescindible (no se migra ahí), pero no estorba.
DIRECT_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────
# Supabase — Auth y Storage
# ─────────────────────────────────────────────────────────
# Públicas (van al navegador). Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://XXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon..."

# SECRETA — solo servidor. Subida/borrado de imágenes en Storage. NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# ─────────────────────────────────────────────────────────
# IA — Leonardo.Ai (Virtual Try-On con GPT Image 2)
# ─────────────────────────────────────────────────────────
# Con AI_MOCK=true el probador devuelve la foto sin modificar (sin gastar créditos).
AI_MOCK="false"
LEONARDO_API_KEY=""

# ─────────────────────────────────────────────────────────
# El tiempo (/weather)
# ─────────────────────────────────────────────────────────
# La página funciona SIN ninguna clave: NWS (api.weather.gov) y Open-Meteo son
# abiertos. Este token es opcional y solo añade la observación real del PWS de
# Gerlach (Synoptic/MesoWest F0371), la estación más cercana al playa.
# Token gratuito en https://synopticdata.com/weatherapi/ (5.000 peticiones/mes).
SYNOPTIC_TOKEN=""
