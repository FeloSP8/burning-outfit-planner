# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — committed: .env.example  /  ignored: .env.local, .env
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma — cliente generado (se regenera con `npx prisma generate`)
/src/generated/

# Base de datos SQLite local
/prisma/dev.db
/prisma/dev.db-journal

# Imágenes subidas por el usuario (no se versionan)
/public/uploads/

# Claude Code
/.claude/

# Archivos locales sueltos
*.jpg
*.jpeg
*.png
*.webp
modelo.*
