generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String          @default("Yo")
  photoUrl       String?
  days           Day[]
  garments       Garment[]
  reactions      Reaction[]
  checklistItems ChecklistItem[]
  checklistChecks ChecklistCheck[]
  styleLooks     StyleLook[]
  djPicks        DjPick[]
  eventPicks     EventPick[]
  campPicks      CampPick[]
  favoriteArtists FavoriteArtist[]
  createdAt      DateTime        @default(now())
}

model Day {
  id     String   @id @default(cuid())
  date   DateTime
  label  String?
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  shifts Shift[]

  @@unique([userId, date])
}

model Shift {
  id     String  @id @default(cuid())
  type   String  // "TARDE" | "NOCHE"
  day    Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId  String
  outfit Outfit?

  @@unique([dayId, type])
}

model Outfit {
  id        String       @id @default(cuid())
  shift     Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId   String       @unique
  items     OutfitItem[]
  tryOn     TryOnResult?
  reactions Reaction[]
  shared    Boolean      @default(false)
  updatedAt DateTime     @updatedAt
}

model OutfitItem {
  id        String  @id @default(cuid())
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId  String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId String

  @@unique([outfitId, garmentId])
}

model Garment {
  id          String       @id @default(cuid())
  name        String
  slot        String       // "TOP" | "BOTTOM" | "SHOES" | "ACCESSORY" | "COAT" | "BIKE_ACCESSORY"
  status      String       @default("PENDIENTE") // "COMPRADO" | "RECIBIDO" | "PENDIENTE"
  photoUrl    String?
  purchaseUrl String?
  notes       String?
  price       Float?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  outfitItems OutfitItem[]
  createdAt   DateTime     @default(now())
}

model TryOnResult {
  id        String   @id @default(cuid())
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId  String   @unique
  imageUrl  String
  userPhoto String
  createdAt DateTime @default(now())
}

// Variante de la foto del usuario generada por IA cambiando solo el estilismo
// de la cara (peinado, tinte, barba). `sourcePhoto` es la imagen de partida y
// `prompt` el detalle exacto que se le pidió al modelo, para poder repetirlo.
model StyleLook {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  imageUrl    String
  sourcePhoto String
  label       String   // resumen legible para la UI ("Cresta mohawk · Rosa neón")
  prompt      String   // instrucciones completas enviadas al modelo
  model       String   // modelo de Leonardo usado
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Reacción de un usuario a un outfit del muro.
// `emoji` puede ser cualquier emoji de reacción (🔥😍👏…) o "⭐" para favorito.
// Único por (usuario, outfit, emoji): no puedes repetir el mismo emoji.
model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([userId, outfitId, emoji])
  @@index([outfitId])
}

// Checklist compartida de compras del grupo.
// type COMMON: con una compra vale para todos (done global + assignee opcional).
// type INDIVIDUAL: cada usuario debe comprar el suyo (estado vía ChecklistCheck).
model ChecklistItem {
  id           String           @id @default(cuid())
  text         String
  type         String           @default("INDIVIDUAL") // "COMMON" | "INDIVIDUAL"
  tags         String           @default("")           // campo libre, separado por comas
  origin       String?                                 // "ESPANA" | "ALLI" | null (sin clasificar)
  done         Boolean          @default(false)        // solo relevante en COMMON
  assigneeName String?                                 // quién se encarga (COMMON)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById  String
  checks       ChecklistCheck[]
  createdAt    DateTime         @default(now())
}

// Un usuario marcó como hecho/comprado un ítem individual de la checklist.
model ChecklistCheck {
  id        String        @id @default(cuid())
  item      ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@unique([itemId, userId])
  @@index([itemId])
}

// Un set del cartel de música que un usuario quiere ver.
// `setId` es el id del catálogo estático de `src/lib/dj-lineups.ts`, no una FK:
// los line-ups vienen de carteles, no de la base de datos. Cambiar un id allí
// deja huérfanas las selecciones de ese set (se ignoran al pintar la agenda).
model DjPick {
  id        String   @id @default(cuid())
  setId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([userId, setId])
  @@index([setId])
}

// Un pase concreto del listado oficial que un usuario quiere ver. Va por pase
// y no por evento porque casi todos se repiten varios días: `startTime` es el
// inicio tal como lo da la API, en hora del playa y con su desfase detrás.
model EventPick {
  id        String   @id @default(cuid())
  eventUid  String
  startTime String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([userId, eventUid, startTime])
  @@index([eventUid])
}

// Un campamento del listado oficial que le interesa a un usuario. Compartido,
// como todo lo demás: en el mapa se ven los de todos, marcados aparte.
model CampPick {
  id        String   @id @default(cuid())
  campUid   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([userId, campUid])
  @@index([campUid])
}

// Un artista que le gusta a un usuario. Ordena la lista de DJs: los suyos
// primero. `artist` es el nombre tal cual aparece en el catálogo de
// `src/lib/dj-lineups.ts`, no una FK — los artistas no son filas. Si un
// cartel se corrige y un nombre cambia, la fila se queda huérfana y se ignora.
model FavoriteArtist {
  id        String   @id @default(cuid())
  artist    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([userId, artist])
  @@index([userId])
}
